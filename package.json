{
  "name": "@hsinpu/symbol-lattice",
  "version": "0.44.0",
  "description": "Evidence-first local code intelligence for TypeScript, JavaScript, Python, Go, Rust, Java, PHP, C++, C#, Ruby, Kotlin, Swift, and Dart projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HsinPu/symbol-lattice.git"
  },
  "bugs": {
    "url": "https://github.com/HsinPu/symbol-lattice/issues"
  },
  "homepage": "https://github.com/HsinPu/symbol-lattice#readme",
  "type": "module",
  "private": true,
  "bin": {
    "symbol-lattice": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "start": "node dist/cli/main.js"
  },
  "dependencies": {
    "@ast-grep/lang-csharp": "0.0.6",
    "@ast-grep/lang-dart": "0.0.7",
    "@ast-grep/lang-kotlin": "0.0.7",
    "@ast-grep/lang-ruby": "0.0.7",
    "@ast-grep/lang-swift": "0.0.8",
    "@ast-grep/napi": "0.45.0",
    "@lezer/cpp": "1.1.6",
    "@lezer/go": "1.0.1",
    "@lezer/java": "1.1.3",
    "@lezer/php": "1.0.5",
    "@lezer/python": "1.1.19",
    "@lezer/rust": "1.0.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "ignore": "^7.0.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "vitest": "^4.1.10"
  }
}
