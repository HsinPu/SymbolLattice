{
  "name": "@hsinpu/symbol-lattice",
  "version": "0.275.0",
  "description": "Evidence-first local code intelligence for TypeScript, JavaScript, ArkTS/ArkUI, Vue, Svelte, Astro, Razor/Blazor, Terraform/OpenTofu, Shopify Liquid, Twig, Laravel Blade, Solidity, CFML/CFScript, Nix, VB.NET, Python/FastAPI/Django Ninja/Flask/Flask-RESTful/Django/Starlette/aiohttp/Sanic, Go, Rust, Java/Spring/Micronaut/Jakarta REST, Groovy, Fortran, Ada, PHP, C, COBOL/CICS, Zig, YAML, XML/MyBatis, Java properties, Shell/Bash, SQL DDL, GraphQL schema with bounded NestJS resolver links, Protocol Buffers declarations with bounded gRPC service contracts, Lua/Luau, Pascal, Objective-C/Objective-C++, R, Elixir, Erlang, Clojure, Perl, Julia, Haskell, OCaml, F#, Nim, C++, C#, Ruby, Kotlin, Swift, Dart, and Scala projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HsinPu/symbol-lattice.git"
  },
  "bugs": {
    "url": "https://github.com/HsinPu/symbol-lattice/issues"
  },
  "homepage": "https://github.com/HsinPu/symbol-lattice#readme",
  "type": "module",
  "private": true,
  "bin": {
    "symbol-lattice": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "scripts/benchmark-read-query-pool.mjs",
    "scripts/verify-mcp-worker-generation.mjs",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:mcp": "node scripts/benchmark-read-query-pool.mjs",
    "release:contract": "node scripts/release-contract.mjs",
    "verify:mcp-worker-generation": "node scripts/verify-mcp-worker-generation.mjs",
    "prepack": "npm run build",
    "start": "node dist/cli/main.js"
  },
  "dependencies": {
    "@ast-grep/lang-csharp": "0.0.6",
    "@ast-grep/lang-dart": "0.0.7",
    "@ast-grep/lang-java": "0.0.7",
    "@ast-grep/lang-kotlin": "0.0.7",
    "@ast-grep/lang-ruby": "0.0.7",
    "@ast-grep/lang-scala": "0.0.7",
    "@ast-grep/lang-swift": "0.0.8",
    "@ast-grep/napi": "0.45.0",
    "@lezer/cpp": "1.1.6",
    "@lezer/go": "1.0.1",
    "@lezer/java": "1.1.3",
    "@lezer/php": "1.0.5",
    "@lezer/python": "1.1.19",
    "@lezer/rust": "1.0.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "ignore": "^7.0.5",
    "jsonc-parser": "3.3.1",
    "saxes": "^6.0.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "vitest": "^4.1.10"
  }
}
